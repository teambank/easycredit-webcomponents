# Copy to `.env` beside docker-compose.yml. Compose reads `.env` for the
# values below and passes them into the container. `docker run -e` overrides
# the same names. Recreate the container after a change; a running process
# keeps the environment it was started with.

WEB_PORT=8088
PRERENDER_HOST=0.0.0.0
PRERENDER_PORT=4711
PRERENDER_WORKERS=2
PRERENDER_WORKER_CONCURRENCY=4
PRERENDER_BUDGET_MS=1000
PRERENDER_WORKER_PORT_BASE=4721
PRERENDER_TIMEOUT=15000
PRERENDER_MAX_BODY=1048576

# Mock page URL used while rendering. Empty keeps https://ratenkauf.easycredit.de/
PRERENDER_HYDRATE_URL=

# Only for docker-compose.network.yml. The Docker network of the shop plugin.
# PLUGIN_NETWORK=your_stack_web
